    ".claude/agents/insumos-observador.md",
    ".claude/agents/investigador.md",
    ".claude/agents/presupuestador.md",
    ".claude/agents/redactor.md",
    ".claude/agents/revisor-figuras.md",
    ".claude/agents/revisor.md",
    ".claude/agents/tikz-optimizer.md",
    ".claude/commands/_propuesta-steps.md",
    ".claude/commands/propuesta-analizar.md",
    ".claude/commands/propuesta-continuar.md",
    ".claude/commands/propuesta-init.md",
    ".claude/commands/propuesta-insumos.md",
    ".claude/commands/propuesta-limpiar.md",
    ".claude/commands/propuesta.md",
